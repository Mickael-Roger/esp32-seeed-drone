#pragma once

// The ESP32 acts as an access point. Pick any SSID/PSK you want — only the
// ground client needs to know them. These same values are also read by the
// Python client (it parses this file).

// AP credentials
#define WIFI_SSID         "esp32-drone"
#define WIFI_PASSWORD     "drone1234"          // ≥ 8 chars for WPA2
#define WIFI_CHANNEL      1

// Static IPv4 layout. The ESP's DHCP server hands the single allowed slot to
// the client at CLIENT_IP, so no IP-discovery handshake is needed.
#define ESP_IP            "192.168.4.1"
#define ESP_NETMASK       "255.255.255.0"
#define CLIENT_IP         "192.168.4.2"

// UDP ports. The client and the ESP both know these from this file.
#define ORIENTATION_PORT  9000     // ESP → client: quaternion (16 B)
#define FLIGHT_PORT       7099     // client → ESP: control packets
#define VIDEO_PORT        9001     // ESP → client: fragmented JPEG frames
